  "narrative": {
    "northStar": "Quiet Systems",
    "overview": "The portfolio behaves like a well-made product page: a white canvas, one confident type scale, soft gray surfaces, and a single blue action color. The interface recedes so the name, the work, and the credentials lead. Density is low, spacing is generous, and every screen has one obvious next step.\n\nThe system replaces the rejected lab-workbook direction. Paper textures, ruled backgrounds, stamps, tab dividers, objective margins, terminal panels, and the red/green annotation palette are gone. What remains is the evidence: seven case studies, four certifications, two roles, and bilingual delivery.\n\nApple's public product language is the pinned reference: system sans, near-black text on white, a blue accent, rounded cards, frosted navigation, and motion that stays quiet. The interface should feel familiar, fast, and expensive through restraint rather than ornament.",
    "keyCharacteristics": [
      "White canvas with soft gray secondary surfaces.",
      "One blue accent for actions and links.",
      "System sans typography at every size.",
      "A single 1060px reading column.",
      "Soft 12–24px radii and pill controls.",
      "Frosted sticky navigation with a segmented language switch.",
      "Status encoded by marker shape plus label.",
      "No texture, stamps, decorative codes, or content shadows."
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "Blue is the only interactive accent. Do not introduce a second brand hue; status tints are semantic, not decorative.",
        "section": "colors"
      },
      {
        "name": "The Status-Is-Semantic Rule",
        "body": "Green, blue, amber, and gray only appear inside status chips, availability dots, or form feedback.",
        "section": "colors"
      },
      {
        "name": "The One Voice Rule",
        "body": "One system sans family, many weights. Do not add a display face, serif, or monospace family for technical flavor.",
        "section": "typography"
      },
      {
        "name": "The Measure Rule",
        "body": "Prose columns stop at 68ch; intros and summaries sit between 36em and 60ch.",
        "section": "layout"
      },
      {
        "name": "The Single Column Rule",
        "body": "One reading column. Secondary material flows below the main content as cards, never in a fixed sidebar.",
        "section": "layout"
      },
      {
        "name": "The Generous Separation Rule",
        "body": "More space above a heading than below it, and at least one full section gap between unrelated ideas.",
        "section": "layout"
      },
      {
        "name": "The Flat Card Rule",
        "body": "No box-shadow, glow, or gradient lift on content. Change surface tone or add a border instead.",
        "section": "elevation"
      },
      {
        "name": "The Frosted Header Rule",
        "body": "Blur belongs to the sticky header and the language-switch thumb only.",
        "section": "elevation"
      },
      {
        "name": "The Soft Geometry Rule",
        "body": "Surfaces are rounded, controls are pills, and the monogram is a circle. Do not mix in square cards or hard-edged buttons.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do keep the canvas white and use surface gray for secondary regions.",
      "Do use one blue accent for actions, links, and schematic strokes.",
      "Do set every text role in the system sans stack; vary weight and size, not family.",
      "Do use 16–24px radii on cards, 12px on fields, and pills for controls.",
      "Do keep prose within 68ch and section spacing generous.",
      "Do encode status with a marker shape plus a label.",
      "Do let secondary material flow below the main column as cards.",
      "Do honor prefers-reduced-motion; the hero rise is the only entrance motion."
    ],
    "donts": [
      "Don’t reintroduce paper textures, ruled backgrounds, stamps, tab dividers, or terminal panels.",
      "Don’t add an objective margin, fixed sidebar, or coded section labels.",
      "Don’t add a second accent hue or use status colors as decoration.",
      "Don’t add content shadows, glows, or gradients.",
      "Don’t set body copy in a serif or monospace face.",
      "Don’t use square cards or hard-edged buttons.",
      "Don’t build a symmetrical card grid where a single column would read better.",
      "Don’t add Tailwind utility classes to components; extend the semantic classes in app/globals.css."
    ]
  }
